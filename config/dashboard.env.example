DASHBOARD_PORT=8050
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=dashboard

# --- Views (all optional) ---
# DASHBOARD_DEFAULT_VIEW=jarvis           # what / opens: classic (default) or jarvis
# JARVIS_DEFAULT_LAYOUT=grid              # grid | focus | ops | kiosk (or 1-4)
# JARVIS_ACCENTS=1                        # per-prop accent colours on by default
# JARVIS_SOUNDTRACK=Should I Stay or Should I Go.mp3   # file in media/ or an http(s) URL
# JARVIS_SOUNDTRACK_VOLUME=0.6
# PROP_STALE_AFTER=60                     # seconds before an "online" prop shows stale
