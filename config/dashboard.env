DASHBOARD_PORT=8050
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=dashboard

# Plugin Control - Choose one approach:
# Option 1: Enable only specific props (recommended)
# PLUGIN_PROPS_ALLOW=tesla_hue_nest,thriller_hue_nest,coffin_jumper

# Option 2: Disable specific props (uncomment to use instead)
PLUGIN_PROPS_DISABLE=example_prop

# Option 3: Disable all prop plugins (uncomment to use instead)
# PLUGIN_DISABLE_ALL_PROPS=1

# Built-in plugin control (optional)
# PLUGIN_BUILTINS_DISABLE=broker_uptime

# --- Views (all optional) ---
# Which view http://localhost:8050/ opens: classic (default) or jarvis
# DASHBOARD_DEFAULT_VIEW=jarvis
# Jarvis layout until a browser picks one: grid | focus | ops | kiosk (or 1-4)
# JARVIS_DEFAULT_LAYOUT=grid
# Start with per-prop accent colours on (also a toggle in the Jarvis settings menu)
# JARVIS_ACCENTS=1
# Soundtrack: file name in the media/ folder, or an http(s) URL. Played once on
# open and restarted on each layout switch. Empty = none.
# JARVIS_SOUNDTRACK=Should I Stay or Should I Go.mp3
# JARVIS_SOUNDTRACK_VOLUME=0.6
# Seconds without live messages before an "online" prop shows as stale
# PROP_STALE_AFTER=60
